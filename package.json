    "verify:gameplay-r2": "node scripts/verify-gameplay-r2-gates.mjs",
    "test:gameplay": "node --test tests/*.test.mjs",
    "test": "npm run test:gameplay",
    "verify:border-proof-r4-1": "node scripts/verify-border-proof-r4-1-gates.mjs",
    "verify:border-install-r4-2": "node scripts/verify-border-install-r4-2.mjs"

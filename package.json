{
  "name": "quantum-cloud-quiz-native",
  "version": "0.1.0-foundation.2",
  "private": true,
  "type": "module",
  "description": "Quantum Certification Quest — governed executable foundation for the QCQ platform.",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" vite.config.ts vitest.config.ts --max-warnings=0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:platinum": "eslint \"src/**/*.{ts,tsx}\" vite.config.ts vitest.config.ts --config eslint.platinum.config.js --max-warnings=0"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}

{
  "name": "quantum-cloud-quiz-master",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify:master && npm run verify:compositor && npm run verify:border-install-r4-2 && npm run verify:border-r4 && npm run verify:border-proof-r4-1 && vite build",
    "preview": "vite preview",
    "verify:master": "node scripts/verify-master.mjs",
    "verify:compositor": "node scripts/verify-compositor-r3-gates.mjs",
    "verify:border-r4": "node scripts/verify-border-frame-r4-gates.mjs",
